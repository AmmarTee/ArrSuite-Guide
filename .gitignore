# Ignore everything by default
*

# But include our documentation files
!.gitignore
!README.md
!ARR_STACK_SETUP.md
!ARCHITECTURE.md
!PLAN.md
!QUICK_REFERENCE.md
!IMPLEMENTATION_SUMMARY.md
!ct-add-storage.sh
!nfs-setup.sh
!vpn-setup.sh
!environment-setup.sh
!storage-setup.sh
!VPN_SPLIT_TUNNEL_SETUP.md
!VPN_GETTING_STARTED.md
!surfshark-template.conf
!example-configs/
!example-configs/**
!lib/
!lib/**
!config/
!config/**
!tests/
!tests/**
!docs/
!docs/**
!LICENSE

# Ignore system files
.bash_history
.bashrc
.profile
.cache/
.dotnet/
.forward
.install-*.log
.local/
.rnd
.ssh/
.vscode-server/
.wget-hsts
immich-upload-guide.md

# Ignore sensitive VPN configs (contain private keys!)
*.conf
ae-dub.conf
wg*.conf

# But allow the templates and config examples (no sensitive data)
!surfshark-template.conf
!config/environment.conf.example
!config/ovh-static.conf
!config/homelab-dhcp.conf
